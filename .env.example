# OpenAI — 이미지 생성 (컷 아트워크)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxx

# 생성 파라미터 기본값
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=medium

# 출력 경로 (에피소드별 하위 폴더가 자동 생성됨)
OUTPUT_DIR=episodes

# Instagram API (Instagram Login) — 게시·댓글·인사이트. 설정: docs/instagram-api.md
# Meta 앱 대시보드 > Instagram > API setup with Instagram business login 의 앱 ID / 시크릿
IG_APP_ID=
IG_APP_SECRET=
# 대시보드에 등록한 OAuth 리디렉션 URI (GitHub Pages 주소 그대로 쓰면 됨)
IG_REDIRECT_URI=https://willowttg.github.io/superwebtoon/
# `python scripts/ig.py auth <code>` 가 채움 (장기 토큰 60일, `refresh` 로 연장)
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=v25.0
# 게시 이미지 원본 URL 루트 (공개 JPEG 이어야 함)
SITE_URL=https://willowttg.github.io/superwebtoon
